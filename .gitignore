# CSV derivados, que son los que se leen en ejecución.
data/geo/gazetteer/ES.txt
data/geo/gazetteer/alternateNamesES.txt
data/geo/gazetteer/admin1CodesASCII.txt
data/geo/gazetteer/admin2Codes.txt
data/geo/gazetteer/featureCodes_en.txt

# Copias de seguridad con marca de tiempo que dejan los scripts al aplicar
*.bak_*
